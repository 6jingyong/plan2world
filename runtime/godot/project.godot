; Plan2World engine-neutral runtime adapter
; Tested target: Godot 4.7.2 desktop, Forward+ renderer.
config_version=5

[application]
config/name="Plan2World Runtime"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=800
window/size/min_height=540
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/enable_pause_aware_picking=true

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}

move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}

move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}

move_slow={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}

move_fast={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}

layout_adjust={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":70), Object(InputEventJoypadButton,"button_index":2)]
}
layout_confirm={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":4194309), Object(InputEventJoypadButton,"button_index":0)]
}
layout_cancel={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":1)]
}
view_toggle={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":4194333), Object(InputEventJoypadButton,"button_index":3)]
}
layout_left={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":4194319), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
layout_right={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":4194321), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
layout_up={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
layout_down={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
look_left={
"deadzone":0.2,
"events":[Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]
}
look_right={
"deadzone":0.2,
"events":[Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]
}
look_up={
"deadzone":0.2,
"events":[Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]
}
look_down={
"deadzone":0.2,
"events":[Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]
}
