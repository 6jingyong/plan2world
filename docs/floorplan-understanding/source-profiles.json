{
  "schemaVersion": "floorplan-condition-catalog-v1",
  "method": "manual-original-raster-observation",
  "purpose": "source conditions and exceptions; no geometry ground truth",
  "coordinateConvention": "original image pixels; x0,y0,x1,y1 boxes locate explanation only",
  "absentConditionMeaning": "not assessed or not confirmed; never proof of absence",
  "algorithmUse": "none; not a solver input",
  "conditions": [
    {
      "id": "colored-marketing",
      "axis": "表示",
      "label": "彩色营销图",
      "implication": "家具纹理、地板色和阴影不能直接作为墙线。"
    },
    {
      "id": "light-linework",
      "axis": "表示",
      "label": "浅底细线图",
      "implication": "玻璃框、门扇、柜体和建筑线需结合上下文区分。"
    },
    {
      "id": "dark-white-linework",
      "axis": "表示",
      "label": "黑底白线图",
      "implication": "线条极性与浅底图相反，细线/双框不等于不存在墙。"
    },
    {
      "id": "pale-frames",
      "axis": "表示",
      "label": "浅色或双线门窗框",
      "implication": "黑色墙体检测不能覆盖所有建筑边界。"
    },
    {
      "id": "diagonal-boundaries",
      "axis": "几何",
      "label": "斜向边界",
      "implication": "允许局部斜线，不统一正交化。"
    },
    {
      "id": "curved-boundaries",
      "axis": "几何",
      "label": "弧形建筑边界",
      "implication": "弧线与圆形家具要按语义区分。"
    },
    {
      "id": "deep-concavity",
      "axis": "几何",
      "label": "深凹外轮廓",
      "implication": "凹口不等于应填补的室内缺面；也不自动等于封闭庭院。"
    },
    {
      "id": "freestanding-partition",
      "axis": "拓扑",
      "label": "自由端隔断",
      "implication": "墙端悬空可能合法；近接提示不等于补墙依据。"
    },
    {
      "id": "open-plan",
      "axis": "拓扑",
      "label": "开放功能区",
      "implication": "多个功能名称可共享一个闭合面。"
    },
    {
      "id": "outdoor-furnishing",
      "axis": "使用",
      "label": "室外家具或植物",
      "implication": "室外家具不要求实体墙围合；阳台等功能区仍须以窗/栏杆/空气边界等建立闭合逻辑轮廓。"
    },
    {
      "id": "empty-labeled-room",
      "axis": "使用",
      "label": "有房名但未画家具",
      "implication": "没有家具不等于室外，也不强迫虚构家具。"
    },
    {
      "id": "dense-service-spaces",
      "axis": "拓扑",
      "label": "密集厨卫衣帽服务区",
      "implication": "小矩形可能是柜、井、设备或房间；须区别。"
    },
    {
      "id": "multiple-aperture-types",
      "axis": "通行",
      "label": "多种门/通口表达",
      "implication": "单门、双门、移门、通口分别观察；落地窗仍为窗。"
    },
    {
      "id": "concealed-door",
      "axis": "通行",
      "label": "暗门标注",
      "implication": "标签是线索，不能在无空间位置依据时自动补门。"
    },
    {
      "id": "continuous-glazing",
      "axis": "边界",
      "label": "连续玻璃边界",
      "implication": "门窗须有同一逻辑宿主基线；中间窗框/立柱并非每段都是独立墙。"
    },
    {
      "id": "possible-railing",
      "axis": "边界",
      "label": "阳台栏杆等高度不明构件",
      "implication": "平面图可能只确定边界位置，不能确定通高墙。"
    },
    {
      "id": "multiple-access",
      "axis": "范围",
      "label": "多个出入口",
      "implication": "不将室内连通性全部绑定单个门。"
    },
    {
      "id": "external-circulation",
      "axis": "范围",
      "label": "范围外交通空间",
      "implication": "外部楼梯/电梯/逃生通道不默认属于户内墙网。"
    },
    {
      "id": "inset-diagrams",
      "axis": "范围",
      "label": "独立附图",
      "implication": "总平面/楼座索引等必须与主体户型分开。"
    },
    {
      "id": "dimension-chains",
      "axis": "尺度",
      "label": "可见尺寸链",
      "implication": "需要清楚数值及对应端点，像素缩放不能沿用印刷比例。"
    },
    {
      "id": "area-labels",
      "axis": "尺度",
      "label": "面积文字",
      "implication": "可做弱一致性复核，不能替代边长与几何真值。"
    },
    {
      "id": "printed-scale-warning",
      "axis": "尺度",
      "label": "印刷比例/非按比例提示",
      "implication": "图纸印刷比例不能直接换算当前 JPEG 的厘米/像素。"
    },
    {
      "id": "no-confirmed-length",
      "axis": "尺度",
      "label": "尚无核验真实参考长度",
      "implication": "保留相对比例；绝对尺寸待明确的参考长度。"
    },
    {
      "id": "watermark-occlusion",
      "axis": "质量",
      "label": "水印遮挡",
      "implication": "遮挡与真实断墙分开归因，不用先验强制闭合。"
    },
    {
      "id": "fine-low-resolution-detail",
      "axis": "质量",
      "label": "细节像素不足",
      "implication": "数值清晰度/门框/柜体边缘需逐项评估，不能笼统认定全图无效。"
    }
  ],
