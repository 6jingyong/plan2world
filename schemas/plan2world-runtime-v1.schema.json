{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2world.local/schemas/plan2world-runtime-v1.schema.json",
  "title": "plan2world-runtime-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "units", "coordinates", "source", "playerProfile", "floors", "entities", "colliders"],
  "properties": {
    "schema": { "const": "plan2world-runtime-v1" },
    "version": { "const": 1 },
    "units": { "const": "metres" },
    "coordinates": {
      "type": "object", "additionalProperties": false, "required": ["handedness", "up", "planX", "planY", "yaw"],
      "properties": {
        "handedness": { "const": "right" }, "up": { "const": "+Y" },
        "planX": { "const": "+X" }, "planY": { "const": "+Z" },
        "yaw": { "const": "clockwise-from-+X" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["projectId", "projectName"],
      "properties": { "projectId": { "$ref": "#/$defs/id" }, "projectName": { "type": "string" }, "architectureSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "playerProfile": { "$ref": "#/$defs/playerProfile" },
    "floors": { "type": "array", "items": { "$ref": "#/$defs/floor" } },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "colliders": { "type": "array", "items": { "$ref": "#/$defs/collider" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "positive": { "type": "number", "exclusiveMinimum": 0 },
    "nonnegative": { "type": "number", "minimum": 0 },
    "vec2": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "vec3": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 3, "maxItems": 3 },
    "positiveVec3": {
      "type": "array", "prefixItems": [{ "$ref": "#/$defs/positive" }, { "$ref": "#/$defs/positive" }, { "$ref": "#/$defs/positive" }],
      "minItems": 3, "maxItems": 3
    },
    "playerProfile": {
      "type": "object", "additionalProperties": false, "required": ["eyeHeight", "radius", "speeds"],
      "properties": {
        "eyeHeight": { "$ref": "#/$defs/positive" }, "radius": { "$ref": "#/$defs/positive" },
        "speeds": {
          "type": "object", "additionalProperties": false, "required": ["slow", "walk", "fast"],
          "properties": {
            "slow": { "$ref": "#/$defs/nonnegative" },
            "walk": { "$ref": "#/$defs/nonnegative" },
            "fast": { "$ref": "#/$defs/nonnegative" }
          }
        }
      }
    },
    "floor": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "level", "elevation", "walkthroughStart", "rooms"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "level": { "type": "integer" }, "elevation": { "type": "number" },
        "entranceDoorId": { "$ref": "#/$defs/id" }, "walkthroughYawClockwiseRadians": { "type": "number" },
        "walkthroughStart": { "anyOf": [{ "$ref": "#/$defs/vec3" }, { "type": "null" }] },
        "rooms": { "type": "array", "items": { "$ref": "#/$defs/room" } }
      }
    },
    "room": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "roomType", "polygon", "holes", "slabThickness", "ceilingHeight"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" },
        "roomType": { "enum": ["indoor", "outdoor", "garage", "utility"] },
        "polygon": { "type": "array", "items": { "$ref": "#/$defs/vec2" }, "minItems": 3 },
        "holes": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/vec2" }, "minItems": 3 } },
        "slabThickness": { "$ref": "#/$defs/positive" },
        "ceilingHeight": { "anyOf": [{ "$ref": "#/$defs/nonnegative" }, { "type": "null" }] },
        "ceilingWallIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 1, "uniqueItems": true }
      }
    },
    "wallPath": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": { "start": { "$ref": "#/$defs/vec2" }, "end": { "$ref": "#/$defs/vec2" }, "control": { "$ref": "#/$defs/vec2" } }
    },
    "closedPose": {
      "type": "object", "additionalProperties": false, "required": ["center", "yawClockwiseRadians"],
      "properties": { "center": { "$ref": "#/$defs/vec3" }, "yawClockwiseRadians": { "type": "number" } }
    },
    "doorLeaf": {
      "type": "object", "required": ["id", "colliderId", "assetRef", "size", "closedPose"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "colliderId": { "$ref": "#/$defs/id" },
        "assetRef": { "$ref": "#/$defs/id" }, "size": { "$ref": "#/$defs/positiveVec3" },
        "closedPose": { "$ref": "#/$defs/closedPose" }
      }
    },
    "swingDoorLeaf": {
      "$ref": "#/$defs/doorLeaf", "unevaluatedProperties": false,
      "required": ["pivot", "axis", "openAngleRadians"],
      "properties": {
        "pivot": { "$ref": "#/$defs/vec3" }, "axis": { "$ref": "#/$defs/vec3" },
        "openAngleRadians": { "type": "number" }
      }
    },
    "slideDoorLeaf": {
      "$ref": "#/$defs/doorLeaf", "unevaluatedProperties": false,
      "required": ["axis", "travel"],
      "properties": { "axis": { "$ref": "#/$defs/vec3" }, "travel": { "$ref": "#/$defs/nonnegative" }, "fixed": { "const": true } },
      "if": { "required": ["fixed"] },
      "then": { "properties": { "travel": { "const": 0 }, "axis": { "const": [0, 0, 0] } } },
      "else": { "properties": { "travel": { "$ref": "#/$defs/positive" } } }
    },
    "blockedDoorLeaf": { "$ref": "#/$defs/doorLeaf", "unevaluatedProperties": false },
    "doorInteraction": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "none" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "leaves"],
          "properties": {
            "kind": { "const": "swing" },
            "leaves": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/swingDoorLeaf" } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "leaves"],
          "properties": {
            "kind": { "const": "slide" },
            "allowHostOverlap": { "type": "boolean" },
            "leaves": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slideDoorLeaf" } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "sourceMotion", "leaves"],
          "properties": {
            "kind": { "const": "unsupported" }, "sourceMotion": { "enum": ["fold", "overhead"] },
            "leaves": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/blockedDoorLeaf" } }
          }
        }
      ]
    },
    "stairTraversal": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "targetFloorId", "startElevation", "endElevation"],
          "properties": {
            "kind": { "const": "ramp" }, "targetFloorId": { "$ref": "#/$defs/id" },
            "startElevation": { "type": "number" }, "endElevation": { "type": "number" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "unsupported" },
            "reason": { "enum": ["missing-target-floor", "invalid-target-elevation", "invalid-geometry", "non-straight"] }
          }
        }
      ]
    },
    "wallEntity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "floorId", "kind", "path", "thickness", "startHeight", "endHeight", "boundaryType", "visible"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "floorId": { "$ref": "#/$defs/id" }, "kind": { "const": "wall" },
        "path": { "$ref": "#/$defs/wallPath" }, "thickness": { "$ref": "#/$defs/positive" },
        "startHeight": { "$ref": "#/$defs/nonnegative" }, "endHeight": { "$ref": "#/$defs/nonnegative" },
        "boundaryType": { "enum": ["solid", "railing", "air"] }, "visible": { "type": "boolean" }
      }
    },
    "doorEntity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "floorId", "kind", "hostWallId", "pathPosition", "width", "height", "doorType", "swingDirection", "flipSide", "closedPose", "interaction"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "floorId": { "$ref": "#/$defs/id" }, "kind": { "const": "door" },
        "hostWallId": { "$ref": "#/$defs/id" }, "pathPosition": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "$ref": "#/$defs/positive" }, "height": { "$ref": "#/$defs/positive" },
        "doorType": { "enum": ["single", "double", "sliding", "french", "pocket", "bifold", "opening", "garage"] },
        "swingDirection": { "enum": ["left", "right"] }, "flipSide": { "type": "boolean" },
        "closedPose": { "$ref": "#/$defs/closedPose" }, "interaction": { "$ref": "#/$defs/doorInteraction" }
      }
    },
    "windowEntity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "floorId", "kind", "hostWallId", "pathPosition", "width", "height", "sillHeight", "windowType", "center", "yawClockwiseRadians"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "floorId": { "$ref": "#/$defs/id" }, "kind": { "const": "window" },
        "hostWallId": { "$ref": "#/$defs/id" }, "pathPosition": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "$ref": "#/$defs/positive" }, "height": { "$ref": "#/$defs/positive" }, "sillHeight": { "$ref": "#/$defs/nonnegative" },
        "windowType": { "enum": ["standard", "fixed", "casement", "sliding", "bay"] },
        "center": { "$ref": "#/$defs/vec3" }, "yawClockwiseRadians": { "type": "number" }
      }
    },
    "furnitureMovement": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "elevation"], "properties": { "kind": { "const": "floor" }, "elevation": { "type": "number" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "roomId", "elevation"], "properties": { "kind": { "const": "ceiling" }, "roomId": { "$ref": "#/$defs/id" }, "elevation": { "type": "number" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "wallId", "side", "blocked", "origin", "tangent", "along", "bottom"], "properties": {
          "kind": { "const": "wall" }, "wallId": { "$ref": "#/$defs/id" }, "side": { "enum": ["left", "right"] },
          "blocked": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["along", "bottom"], "properties": { "along": { "$ref": "#/$defs/vec2" }, "bottom": { "$ref": "#/$defs/vec2" } } } }, "origin": { "$ref": "#/$defs/vec3" }, "tangent": { "$ref": "#/$defs/vec3" }, "along": { "$ref": "#/$defs/vec2" }, "bottom": { "$ref": "#/$defs/vec2" }
        } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "unbound-wall" } } }
      ]
    },
    "furnitureEntity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "floorId", "kind", "catalogId", "assetRef", "position", "yawClockwiseRadians", "size", "locked", "movement"],
      "properties": {
        "locked": { "type": "boolean" }, "movement": { "$ref": "#/$defs/furnitureMovement" },
        "light": { "$ref": "#/$defs/furnitureLight" },
        "id": { "$ref": "#/$defs/id" }, "floorId": { "$ref": "#/$defs/id" }, "kind": { "const": "furniture" },
        "catalogId": { "$ref": "#/$defs/id" }, "sourceCategory": { "type": "string" }, "assetRef": { "type": "string", "minLength": 1 },
        "mirror": { "type": "array", "prefixItems": [{ "enum": [-1, 1] }, { "const": 1 }, { "enum": [-1, 1] }], "minItems": 3, "maxItems": 3 },
        "position": { "$ref": "#/$defs/vec3" }, "yawClockwiseRadians": { "type": "number" }, "size": { "$ref": "#/$defs/positiveVec3" }
      }
    },
    "furnitureLight": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "enabled", "lumens", "temperatureKelvin", "color", "range", "spotAngleDegrees", "localPosition", "direction"],
      "properties": {
        "kind": { "enum": ["omni", "spot"] }, "enabled": { "type": "boolean" },
        "lumens": { "type": "number", "minimum": 0, "maximum": 20000 },
        "temperatureKelvin": { "type": "number", "minimum": 2000, "maximum": 10000 },
        "color": { "$ref": "#/$defs/vec3" }, "localPosition": { "$ref": "#/$defs/vec3" }, "direction": { "$ref": "#/$defs/vec3" },
        "range": { "$ref": "#/$defs/positive" }, "spotAngleDegrees": { "type": "number", "exclusiveMinimum": 0, "maximum": 90 }
      }
    },
    "columnEntity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "floorId", "kind", "shape", "position", "yawClockwiseRadians", "diameter", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "floorId": { "$ref": "#/$defs/id" }, "kind": { "const": "column" },
        "shape": { "enum": ["round", "square"] }, "position": { "$ref": "#/$defs/vec3" }, "yawClockwiseRadians": { "type": "number" },
        "diameter": { "$ref": "#/$defs/positive" }, "height": { "$ref": "#/$defs/positive" }
      }
    },
    "stairEntity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "floorId", "kind", "position", "yawClockwiseRadians", "width", "depth", "riserCount", "direction", "stairType", "traversal"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "floorId": { "$ref": "#/$defs/id" }, "kind": { "const": "stair" },
        "position": { "$ref": "#/$defs/vec3" }, "yawClockwiseRadians": { "type": "number" },
        "width": { "$ref": "#/$defs/positive" }, "depth": { "$ref": "#/$defs/positive" }, "riserCount": { "type": "integer", "minimum": 1 },
        "direction": { "enum": ["up", "down"] }, "stairType": { "enum": ["straight", "l-shaped", "u-shaped", "spiral"] },
        "traversal": { "$ref": "#/$defs/stairTraversal" }
      }
    },
    "entity": {
      "oneOf": [
        { "$ref": "#/$defs/wallEntity" }, { "$ref": "#/$defs/doorEntity" }, { "$ref": "#/$defs/windowEntity" },
        { "$ref": "#/$defs/furnitureEntity" }, { "$ref": "#/$defs/columnEntity" }, { "$ref": "#/$defs/stairEntity" }
      ]
    },
    "boxCollider": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ownerId", "floorId", "dynamic", "kind", "center", "size", "yawClockwiseRadians"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "ownerId": { "$ref": "#/$defs/id" }, "floorId": { "$ref": "#/$defs/id" },
        "dynamic": { "type": "boolean" }, "kind": { "const": "box" }, "center": { "$ref": "#/$defs/vec3" },
        "size": { "$ref": "#/$defs/positiveVec3" }, "yawClockwiseRadians": { "type": "number" }
      }
    },
    "cylinderCollider": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ownerId", "floorId", "dynamic", "kind", "center", "radius", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "ownerId": { "$ref": "#/$defs/id" }, "floorId": { "$ref": "#/$defs/id" },
        "dynamic": { "type": "boolean" }, "kind": { "const": "cylinder" }, "center": { "$ref": "#/$defs/vec3" },
        "radius": { "$ref": "#/$defs/positive" }, "height": { "$ref": "#/$defs/positive" }
      }
    },
    "triangleMeshCollider": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ownerId", "floorId", "dynamic", "kind", "vertices", "indices"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "ownerId": { "$ref": "#/$defs/id" }, "floorId": { "$ref": "#/$defs/id" },
        "dynamic": { "const": false }, "kind": { "const": "triangle-mesh" },
        "vertices": { "type": "array", "items": { "$ref": "#/$defs/vec3" }, "minItems": 3 },
        "indices": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 3 }
      }
    },
    "collider": {
      "oneOf": [
        { "$ref": "#/$defs/boxCollider" }, { "$ref": "#/$defs/cylinderCollider" }, { "$ref": "#/$defs/triangleMeshCollider" }
      ]
    }
  }
}
